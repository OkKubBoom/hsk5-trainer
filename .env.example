# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริง

# สร้างคีย์ใหม่ด้วย:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ถ้าไม่ตั้งและ DJANGO_DEBUG=0 ระบบจะไม่ยอมสตาร์ท (ตั้งใจ)
DJANGO_SECRET_KEY=เปลี่ยนค่านี้ก่อนขึ้นเซิร์ฟเวอร์

# 0 = โหมดจริง (ปิดหน้า error ที่เปิดเผยโค้ด) · บนเครื่องพัฒนาใส่ 1
# ค่าตั้งต้นถ้าไม่ตั้งเลยคือ 0 — เลือกทางปลอดภัยไว้ก่อน
DJANGO_DEBUG=0

# โดเมนที่อนุญาต คั่นด้วยจุลภาค
DJANGO_ALLOWED_HOSTS=hsk5-trainer.example.com

# ต้องใส่ https:// นำหน้า มิฉะนั้นฟอร์มจะส่งไม่ผ่าน
DJANGO_CSRF_TRUSTED_ORIGINS=https://hsk5-trainer.example.com

# แพลตฟอร์มส่วนใหญ่ใส่ค่านี้ให้อัตโนมัติเมื่อสร้าง Postgres
# ถ้าเว้นว่างไว้ ระบบจะใช้ SQLite ในเครื่องแทน
DATABASE_URL=

# ปิดเฉพาะตอนทดสอบหลังพร็อกซีที่ยังไม่มี HTTPS
DJANGO_SECURE_SSL_REDIRECT=1

# กุญแจสำหรับให้ Claude ตรวจเรียงความ — ไม่ตั้งก็ใช้ระบบได้ แค่ตรวจอัตโนมัติไม่ได้
# ขอได้ที่ https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
