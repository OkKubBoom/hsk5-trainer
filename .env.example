# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit .env
DJANGO_SECRET_KEY=เปลี่ยนค่านี้ก่อนขึ้น production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# dev = ว่างไว้ ใช้ SQLite / prod = postgres://user:pass@host:5432/dbname
DATABASE_URL=

# เขตเวลาผู้เรียน
TIME_ZONE=Asia/Bangkok

# วันสอบเป้าหมาย (ใช้โดยตัวจัดตารางทบทวน)
TARGET_EXAM_DATE=2026-12-13
